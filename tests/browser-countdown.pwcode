async page=>{
  page.setDefaultTimeout(10000);const errors=[];page.on('pageerror',e=>errors.push(e.message));
  await page.addInitScript(()=>{
    const now=Date.now.bind(Date);window.__clockOffset=0;Date.now=()=>now()+window.__clockOffset;Math.random=()=>0;
    AudioParam.prototype.cancelAndHoldAtTime=undefined;AbortSignal.timeout=undefined;
  });
  await page.goto('http://127.0.0.1:8788');
  const layouts=[];
  for(const [width,height] of [[1600,1000],[1024,1366],[390,844],[320,844]]){
    await page.setViewportSize({width,height});
    const layout=await page.evaluate(()=>{
      const mind=document.querySelector('.mind-monitor').getBoundingClientRect(),silo=document.querySelector('.silo-monitor').getBoundingClientRect();
      const panel=document.querySelector('.code-monitor').getBoundingClientRect(),clock=document.querySelector('.launch-clock').getBoundingClientRect();
      return{width:innerWidth,overflow:document.documentElement.scrollWidth>innerWidth,swapped:mind.left<silo.left,clockFits:clock.top>=panel.top&&clock.bottom<=panel.bottom,clock:document.querySelector('#launch-countdown').textContent};
    });
    if(layout.overflow||!layout.swapped||!layout.clockFits||layout.clock!=='03:00')throw Error('Countdown layout failed '+JSON.stringify(layout));
    await page.screenshot({path:`output/playwright/countdown-${width}.png`,fullPage:true});layouts.push(layout);
  }
  await page.setViewportSize({width:1024,height:1366});
  await page.evaluate(async()=>{
    window.__voices=[];const {Soundtrack}=await import('/src/audio.js');const start=Soundtrack.prototype.start,speak=Soundtrack.prototype.speak;
    Soundtrack.prototype.start=async function(...args){const result=await start.apply(this,args);window.__audio=this;return result;};
    Soundtrack.prototype.speak=function(text){const e={text,start:performance.now()};window.__voices.push(e);const result=speak.call(this,text);result.then(status=>{e.status=status;e.end=performance.now();});return result;};
  });
  await page.locator('#connect-button').click();await page.locator('#skip-intro').click();
  await page.waitForFunction(()=>window.__audio?.ctx?.state==='running');
  await page.waitForTimeout(1200);
  const started=await page.locator('#launch-countdown').innerText();if(started==='03:00')throw Error('Countdown is not running after CONNECT');
  await page.evaluate(()=>window.__audio.ctx.suspend());
  await page.waitForFunction(()=>document.querySelector('#audio-toggle').textContent==='ENABLE AUDIO');
  await page.locator('#audio-toggle').click();
  await page.waitForFunction(()=>window.__audio.enabled&&window.__audio.ctx.state==='running'&&document.querySelector('#audio-toggle').textContent==='AUDIO ON');
  const output=await page.evaluate(async()=>{
    const audio=window.__audio,analyser=audio.ctx.createAnalyser();audio.master.connect(analyser);analyser.fftSize=2048;
    let peak=0;for(let i=0;i<16;i++){await new Promise(r=>setTimeout(r,50));const values=new Float32Array(analyser.fftSize);analyser.getFloatTimeDomainData(values);peak=Math.max(peak,Math.sqrt(values.reduce((s,n)=>s+n*n,0)/values.length));}
    return{peak,state:audio.ctx.state,enabled:audio.enabled};
  });if(output.peak<.001)throw Error('Audio remained silent after retry '+JSON.stringify(output));
  const move=async i=>{await page.locator(`[data-cell="${i}"]`).click();await page.waitForFunction(()=>document.body.dataset.phase!=='playing'||!!document.querySelector('.cell:not(:disabled)'));};
  await page.locator('#one-player').click();for(const i of [0,3,6])await move(i);
  if(!await page.locator('#dialogue-text').innerText().then(s=>s.includes('You have won the game. But I will win the next game.')))throw Error('Player victory dialogue missing');
  await page.waitForFunction(()=>window.__voices.some(e=>e.text.startsWith('You have won')&&e.status==='ended'),{},{timeout:12000});
  await page.evaluate(()=>{Math.random=()=>.99;});
  await page.locator('#one-player').click();for(const i of [0,1,3])await move(i);
  if(!await page.locator('#dialogue-text').innerText().then(s=>s.includes('I have won this round. Shall we play again?')&&!s.includes('Goodbye')))throw Error('Player loss dialogue missing');
  await page.waitForFunction(()=>window.__voices.some(e=>e.text.startsWith('I have won this round')&&e.status==='ended'),{},{timeout:15000});
  for(let round=3;round<=4;round++){
    await page.locator('#one-player').click();
    while(await page.locator('body').getAttribute('data-phase')==='playing'){
      const i=await page.evaluate(async()=>(await import('/src/engine.js')).perfectMove([...document.querySelectorAll('.cell')].map(c=>c.textContent||null),'X',()=>0));await move(i);
    }
  }
  if(await page.locator('body').getAttribute('data-phase')!=='between'||!await page.locator('#decision-timer').isHidden())throw Error('Round count still triggers an early launch');
  if(await page.evaluate(()=>window.__voices.some(e=>/goodbye/i.test(e.text))))throw Error('Goodbye spoke before launch deadline');
  await page.evaluate(()=>{window.__clockOffset+=60000;});
  await page.waitForFunction(()=>document.querySelectorAll('.code-char.locked').length>=3);
  const progress=await page.locator('#code-status').innerText();
  await page.locator('#one-player').click();await page.locator('[data-cell="0"]').click();
  await page.evaluate(()=>{window.__clockOffset+=180000;document.dispatchEvent(new Event('visibilitychange'));});
  await page.waitForFunction(()=>document.body.dataset.phase==='launching');
  if(await page.locator('#launch-countdown').innerText()!=='00:00'||await page.locator('#code-title').innerText()!=='LAUNCH CODE DECRYPTED'||await page.locator('.code-char.locked').count()!==10)throw Error('Deadline failed to decrypt all code');
  await page.waitForFunction(()=>window.__voices.some(e=>/goodbye/i.test(e.text)&&e.status==='ended'),{},{timeout:12000});
  const farewell=await page.evaluate(()=>window.__voices.find(e=>/goodbye/i.test(e.text)));
  if(!farewell||farewell.status!=='ended')throw Error('Deadline farewell incomplete');
  await page.locator('#restart-button').click();await page.waitForTimeout(1300);
  if(await page.locator('body').getAttribute('data-phase')!=='standby'||await page.locator('#launch-countdown').innerText()!=='03:00'||await page.locator('.cell').allTextContents().then(c=>c.join(''))!=='')throw Error('Reset retained timer or late AI move');
  if(errors.length)throw Error(errors.join('\n'));
  return {layouts,countdownStarted:started,audioRetry:output,olderWebAudioAPIs:'passed',winAndLossRecordings:'completed',fourGames:'no early launch',timedCodeProgress:progress,deadlineDuringAITurn:'launching',reset:'03:00 / no stale move',errors};
}
