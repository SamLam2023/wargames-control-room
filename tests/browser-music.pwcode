async (page) => {
  const errors = [];
  page.on('pageerror', error => errors.push(error.message));
  await page.addInitScript(() => {
    const Context = window.AudioContext;
    window.__audioContexts = [];
    window.AudioContext = class extends Context {
      constructor(...args) { super(...args); window.__audioContexts.push(this); }
    };
  });
  const origin = new URL(page.url()).origin;
  await page.goto(origin);
  await page.locator('#connect-button').click();
  await page.locator('#restart-button').click();
  await page.waitForTimeout(600);
  await page.evaluate(async () => {
    const { Soundtrack } = await import('/src/audio.js');
    window.__score = new Soundtrack();
    await window.__score.start();
    window.__score.setMode('intro', .12);
    const analyser = window.__score.ctx.createAnalyser();
    analyser.fftSize = 4096;
    window.__score.master.connect(analyser);
    window.__musicAnalyser = analyser;
    window.__musicRms = () => {
      const values = new Float32Array(analyser.fftSize);
      analyser.getFloatTimeDomainData(values);
      return Math.sqrt(values.reduce((sum, value) => sum + value * value, 0) / values.length);
    };
  });
  await page.waitForFunction(() => window.__score.activeTrack?.cue === 'intro' && window.__score.buffers.size === 4);
  await page.waitForTimeout(1600);
  const decoded = await page.evaluate(() => [...window.__score.buffers].map(([cue, buffer]) => ({ cue, seconds: buffer.duration, channels: buffer.numberOfChannels })));
  if (decoded.some(cue => cue.channels !== 2 || cue.seconds < 29)) throw Error('Invalid decoded music');
  const levels = [];
  for (const [mode, cue] of [['intro', 'intro'], ['playing', 'gameplay'], ['selfplay', 'crisis'], ['resolved', 'resolution']]) {
    await page.evaluate(mode => window.__score.setMode(mode, mode === 'selfplay' ? 1 : .3), mode);
    await page.waitForFunction(cue => window.__score.activeTrack?.cue === cue, cue);
    await page.waitForTimeout(1800);
    const result = await page.evaluate(() => ({ cue: window.__score.activeTrack.cue, rms: window.__musicRms(), tracks: window.__score.tracks.size }));
    if (result.rms < .003 || result.tracks !== 1) throw Error('Music silent or old cue leaked: ' + JSON.stringify(result));
    levels.push(result);
  }
  // Seek close to the end of the actual decoded critical cue to exercise the
  // loop seam in real time, without waiting an entire thirty-second loop.
  const loop = await page.evaluate(async () => {
    const score = window.__score;
    score.setMode('simulation', 1);
    await score.updateMusic();
    return new Promise(resolve => {
      const source = score.ctx.createBufferSource();
      source.buffer = score.buffers.get('crisis'); source.loop = true;
      const analyser = score.ctx.createAnalyser(); analyser.fftSize = 2048;
      source.connect(analyser); analyser.connect(score.ctx.destination);
      const at = score.ctx.currentTime;
      source.start(at, source.buffer.duration - .15);
      let samples = 0; let silent = 0; let minimum = 1;
      const timer = setInterval(() => {
        const values = new Float32Array(analyser.fftSize); analyser.getFloatTimeDomainData(values);
        const rms = Math.sqrt(values.reduce((sum, value) => sum + value * value, 0) / values.length);
        if (score.ctx.currentTime - at > .07) { samples++; if (rms < .001) silent++; minimum = Math.min(minimum, rms); }
      }, 10);
      setTimeout(() => { clearInterval(timer); source.stop(); source.disconnect(); analyser.disconnect(); resolve({ samples, silent, minimum }); }, 500);
    });
  });
  if (loop.samples < 10 || loop.silent > 1) throw Error('Gap in music loop: ' + JSON.stringify(loop));
  await page.evaluate(() => window.__score.setEnabled(false));
  await page.waitForTimeout(1100);
  const mutedRms = await page.evaluate(() => window.__musicRms());
  if (mutedRms > .0001) throw Error('Mute left music audible');
  await page.evaluate(() => window.__score.setEnabled(true));
  await page.waitForTimeout(1100);
  if (await page.evaluate(() => window.__musicRms()) < .003) throw Error('Unmute did not restore music');
  await page.evaluate(async () => {
    window.__score.setMode('resolved', 0); await window.__score.updateMusic();
    window.__score.setMode('playing', .3); await window.__score.updateMusic();
    window.__score.setMode('standby', 0);
  });
  await page.waitForTimeout(800);
  const reset = await page.evaluate(() => ({ tracks: window.__score.tracks.size, rms: window.__musicRms() }));
  if (reset.tracks !== 0 || reset.rms > .0001) throw Error('RESET left music playing');
  if (errors.length) throw Error(errors.join('\n'));
  return { decoded, levels, loop, mutedRms, reset, errors };
}
